<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <title>{{ shop.name }}</title>
    {% render 'fonts' %}
    <style>
      :root {
        --earth: {{ settings.color_earth }};
        --earth-2: {{ settings.color_earth | color_mix: settings.color_bone, 92 }};
        --bone: {{ settings.color_bone }};
        --bone-2: {{ settings.color_bone | color_mix: settings.color_earth, 82 }};
        --mist: {{ settings.color_bone | color_mix: settings.color_earth, 58 }};
        --line: {{ settings.color_bone | color_modify: 'alpha', 0.14 }};
        --gold: {{ settings.color_gold }};
        --on-gold: {{ settings.color_earth }};
        --paper: {{ settings.color_earth | color_modify: 'alpha', 0.88 }};
        --photo: {{ settings.color_earth | color_darken: 18 }};
      }
    </style>
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body class="template-password">
    <main id="main">
      {{ content_for_layout }}
    </main>
  </body>
</html>
