{%- comment -%} Font inclusi nel tema (nessuna richiesta a Google, meglio per privacy e velocità). {%- endcomment -%}
{{ 'bodoni-moda.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: true }}
{{ 'hanken-grotesk.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: true }}
<style>
  @font-face { font-family: "Bodoni Moda"; font-style: normal; font-weight: 400 900; font-display: swap; src: url("{{ 'bodoni-moda.woff2' | asset_url }}") format("woff2"); }
  @font-face { font-family: "Bodoni Moda"; font-style: italic; font-weight: 400 900; font-display: swap; src: url("{{ 'bodoni-moda-italic.woff2' | asset_url }}") format("woff2"); }
  @font-face { font-family: "Hanken Grotesk"; font-style: normal; font-weight: 100 900; font-display: swap; src: url("{{ 'hanken-grotesk.woff2' | asset_url }}") format("woff2"); }
  @font-face { font-family: "DM Mono"; font-style: normal; font-weight: 400; font-display: swap; src: url("{{ 'dm-mono.woff2' | asset_url }}") format("woff2"); }
</style>
