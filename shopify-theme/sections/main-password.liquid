<section class="page wrap password">
  <div class="head"><span class="label">Presto online</span><h1 class="title"><span>La culla</span><em>della <b>Luna</b></em></h1></div>
  {%- if shop.password_message != blank -%}<p class="prose">{{ shop.password_message }}</p>{%- endif -%}
  {%- form 'storefront_password', class: 'contact-form' -%}
    {%- if form.errors -%}<p class="form-err" role="alert">Password non corretta.</p>{%- endif -%}
    <label for="Password">Password del negozio</label>
    <input id="Password" type="password" name="password" autocomplete="current-password" required>
    <button type="submit" class="btn btn-gold">Entra</button>
  {%- endform -%}
</section>

{% schema %}
{
  "name": "Password",
  "settings": []
}
{% endschema %}
